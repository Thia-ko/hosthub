# Banco de dados
DATABASE_URL=postgresql+asyncpg://hosthub:hosthub@db:5432/hosthub
POSTGRES_DB=hosthub
POSTGRES_USER=hosthub
POSTGRES_PASSWORD=hosthub

# Autenticacao
JWT_SECRET=change-me

# URL interna da API dentro da rede docker (usada por server components do Next.js)
INTERNAL_API_URL=http://api:8000

# Primeiro usuario admin (bootstrap via app/db/seed.py)
SEED_ADMIN_EMAIL=admin@hosthub.local
SEED_ADMIN_PASSWORD=change-me

# Assistente de IA (chave do dono da plataforma, compativel com Chat Completions da OpenAI)
AI_ASSIST_API_KEY=
AI_ASSIST_BASE_URL=https://api.openai.com/v1
AI_ASSIST_MODEL=gpt-4o-mini
AI_ASSIST_DAILY_TOKEN_LIMIT_DEFAULT=50000

# Cloudflare Turnstile (login) - preenchido apos criar o site no dashboard Cloudflare
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Access (protege somente /admin) - preenchido apos configurar o Zero Trust no dashboard Cloudflare
CF_ACCESS_TEAM_DOMAIN=

# Producao (Fase 10)
DOMAIN=
