# Banco de dados
DATABASE_URL=postgresql+asyncpg://hosthub:hosthub@db:5432/hosthub
POSTGRES_DB=hosthub
POSTGRES_USER=hosthub
POSTGRES_PASSWORD=hosthub

# Autenticacao
JWT_SECRET=change-me
# Cookies de sessao exigem HTTPS por padrao (correto em producao atras do Caddy/Cloudflare).
# So desative (false) se estiver acessando via HTTP puro sem TLS (ex: teste por IP publico sem dominio).
COOKIE_SECURE=true

# URL interna da API dentro da rede docker (usada por server components do Next.js)
INTERNAL_API_URL=http://api:8000

# Origens extras liberadas para o dev server do Next.js (protecao contra DNS rebinding).
# Preencher com host:porta (separado por virgula) se for acessar o ambiente de dev por IP/dominio
# diferente de localhost (ex: teste via IP publico de uma VPS).
NEXT_DEV_ALLOWED_ORIGINS=

# Primeiro usuario admin (bootstrap via app/db/seed.py)
SEED_ADMIN_EMAIL=admin@hosthub.local
SEED_ADMIN_PASSWORD=change-me

# Assistente de IA (chave do dono da plataforma, compativel com Chat Completions da OpenAI).
# Estes 4 valores sao apenas o fallback: o admin pode sobrescrever qualquer um deles pelo painel
# (Configuracoes > IA), que fica salvo no banco e tem prioridade sobre estas env vars.
# AI_ASSIST_MODEL responde texto e imagem (precisa ser um modelo com visao, ex: gpt-4o-mini ja e).
# AI_ASSIST_TRANSCRIBE_MODEL transcreve audio recebido do cliente (endpoint /audio/transcriptions,
# padrao Whisper - troque se seu provedor usar outro nome de modelo).
AI_ASSIST_API_KEY=
AI_ASSIST_BASE_URL=https://api.openai.com/v1
AI_ASSIST_MODEL=gpt-4o-mini
AI_ASSIST_TRANSCRIBE_MODEL=whisper-1
AI_ASSIST_DAILY_TOKEN_LIMIT_DEFAULT=50000

# WhatsApp - usado para o HostHub responder atendimentos automaticamente.
# WhatsBotMais (todos os clientes atuais, API oficial da Meta): a credencial de cada atendimento
# ja vem no proprio evento recebido, so precisa da URL base da API deles.
WHATSBOTMAIS_API_BASE_URL=https://api2.whatsbotmais.com.br

# Evolution API (self-hosted, fallback para futuros clientes fora do WhatsBotMais).
# URL base e chave de administracao; cada instancia do HostHub aponta para uma "instance" do
# Evolution via o campo proprio no painel.
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=

# Cloudflare Turnstile (login) - preenchido apos criar o site no dashboard Cloudflare
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Access (protege somente /admin) - preenchido apos configurar o Zero Trust no dashboard Cloudflare
CF_ACCESS_TEAM_DOMAIN=

# Producao (Fase 10)
DOMAIN=
